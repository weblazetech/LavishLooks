{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Warm, editorial luxury identity for Karthikeya Lavish Looks, a unisex beauty salon in Kashibugga, Warangal. Ivory porcelain surfaces, deep peacock teal, bridal gold, and high-contrast Garamond display type. Built for two jobs at once: booking everyday grooming (men and women) and winning bridal.",
  "color": {
    "$type": "color",
    "ivory": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.98,
          0.965,
          0.941
        ],
        "hex": "#faf6f0"
      }
    },
    "sand": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.953,
          0.925,
          0.886
        ],
        "hex": "#f3ece2"
      }
    },
    "porcelain": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.992,
          0.976
        ],
        "hex": "#fffdf9"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.133,
          0.188,
          0.176
        ],
        "hex": "#22302d"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.353,
          0.396,
          0.373
        ],
        "hex": "#5a655f"
      }
    },
    "teal": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.42,
          0.384
        ],
        "hex": "#0f6b62"
      }
    },
    "teal-deep": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.318,
          0.282
        ],
        "hex": "#0b5148"
      }
    },
    "gold": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.631,
          0.384,
          0.027
        ],
        "hex": "#a16207"
      }
    },
    "hairline": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.89,
          0.851,
          0.796
        ],
        "hex": "#e3d9cb"
      }
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.42,
          0.384
        ],
        "hex": "#0f6b62"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 88,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    },
    "card": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "img": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "input": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Cormorant Garamond",
        "fontSize": {
          "value": 4.5,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Cormorant Garamond",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Montserrat",
        "fontSize": {
          "value": 1.375,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Montserrat",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Montserrat",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.02,
          "unit": "em"
        }
      }
    },
    "price": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Montserrat",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    },
    "kicker": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Montserrat",
        "fontSize": {
          "value": 0.8125,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.18,
          "unit": "em"
        }
      }
    },
    "pull": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Cormorant Garamond",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Montserrat",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    }
  }
}
